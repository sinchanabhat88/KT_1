{
  "_version": "1.89.0",
  "sap.app": {
    "id": "frontend",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.33.0",
      "toolsId": "923d6c55-fd37-495a-9a33-086cdfda8079"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/event/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    }
  },

  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },

  "sap.ui5": {
    "flexEnabled": true,

    "dependencies": {
      "minUI5Version": "1.153.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },

    "contentDensities": {
      "compact": true,
      "cozy": true
    },

    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "frontend.i18n.i18n"
        }
      },

      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },

    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },

    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "frontend.view",
        "async": true,
        "viewPath": "frontend.view"
      },

      "routes": [
        {
          "name": "Routemain",
          "pattern": ":?query:",
          "target": [
            "Targetmain"
          ]
        },
        {
          "name": "RouteRegistrations",
          "pattern": "registrations",
          "target": [
            "TargetRegistrations"
          ]
        }
      ],

      "targets": {
        "Targetmain": {
          "id": "main",
          "name": "main"
        },

        "TargetRegistrations": {
          "id": "registrations",
          "name": "Registrations"
        }
      }
    },

    "rootView": {
      "viewName": "frontend.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}